# =================================================================
# 1. APPLICATION & SERVER BINDING
# =================================================================
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed frontend origins for CORS (e.g., your Vercel deployment URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Custom storage root directory (defaults to 'data' in repository root)
# In cloud hosting with persistent volume, set to mount path (e.g. /mnt/data)
DATA_DIR=data

# =================================================================
# 2. LLM STRUCTURED EXTRACTION CONFIGURATION
# Supported providers: 'mock', 'ollama', 'gemini', 'openai'
# =================================================================
LLM_PROVIDER=mock
LLM_MODEL=mock-extractor

# Local Ollama AI Configuration (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Google Gemini Configuration (optional, if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI GPT Configuration (optional, if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Fallback generic LLM key
LLM_API_KEY=

# =================================================================
# 3. DETERMINISTIC GST VALIDATION SETTINGS
# =================================================================
VALIDATION_AMOUNT_TOLERANCE=1.00
VALIDATION_PERCENTAGE_TOLERANCE=0.10
VALIDATION_STRICT_GSTIN_CHECKSUM=false

